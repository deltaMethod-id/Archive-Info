{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/pages/index.html" },
    { "src": "/index", "dest": "/pages/index.html" },
    { "src": "/list", "dest": "/pages/list.html" },
    { "src": "/dashboard", "dest": "/pages/dashboard.html" },
    { "src": "/403", "dest": "/pages/403.html" },
    { "src": "/404", "dest": "/pages/404.html" },
    { "src": "/(.*)", "status": 404, "dest": "/pages/404.html" }
  ]
}
